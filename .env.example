# Application Settings
APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-at-least-32-random-characters"
NODE_ENV="development"

# Development fallback: set to "true" to allow demo fallback when MySQL is disconnected
DEMO_MODE="true"

# MySQL Database
DATABASE_URL="mysql://app:app@localhost:3306/app_template"

# Redis Cache & Rate Limiting (optional in dev, recommended for production)
REDIS_URL="redis://localhost:6379"

# Seed User Account (for `npx prisma db seed`)
SEED_USER_EMAIL="user@example.com"
SEED_USER_PASSWORD="replace-with-at-least-12-characters"

# Optional Server Action Security
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
